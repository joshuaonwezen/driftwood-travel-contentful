# --- Contentful space -------------------------------------------------------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Content Management API personal access token (CFPAT-...).
# Used only by the scripts in /scripts (setup, migrations, seed, export).
CONTENTFUL_MANAGEMENT_TOKEN=

# Content Delivery API + Content Preview API tokens.
# `npm run cf:setup` creates these and writes them into .env.local.
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# --- Next.js ------------------------------------------------------------------
# Shared secret for /api/draft (Contentful preview URLs) and /api/revalidate (webhook).
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
